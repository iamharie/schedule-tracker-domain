PORT=4000
NODE_ENV=development

# Same database as staystrong-backend — reuse the DATABASE_URL from that project's .env
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/DATABASE_NAME

# Frontend origin for CORS (comma-separated for multiple)
CORS_ORIGIN=http://localhost:5173

# App URL for building verification links in emails
APP_URL=http://localhost:5173

# JWT — added in Phase 2
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Email — added in Phase 2
# Local dev: EMAIL_TRANSPORT=console (logs link to terminal, no real send)
# Production: EMAIL_TRANSPORT=resend or EMAIL_TRANSPORT=smtp
EMAIL_TRANSPORT=console
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

# Datadog (optional, matches staystrong-backend)
DD_API_KEY=
DD_SITE=datadoghq.com
DD_ENV=local
DD_SERVICE=schedule-tracker-domain
DD_VERSION=0.0.1
DD_TRACE_ENABLED=false
